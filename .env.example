# Copy to .env and fill in what you need. The daemon loads this automatically.

# Model API keys
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Jev decision model (TypeSafe System One, early access). Setting a key turns
# the fast audit, browse loop, and untrusted-content guardrail on by default;
# tune or disable everything in Settings -> Decision model.
TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_DEFAULT_MODEL=jev-latest
# Set to false to keep Jev off even when a key is present
# OPENBOT_DECISION_ENABLED=true

# Daemon
OPENBOT_PORT=4170
# OPENBOT_DATA_DIR=~/.local/share/openbot   # defaults: macOS Application Support, Linux XDG, Windows AppData

# Sandbox (bot computers, served by the Lima VM)
OPENBOT_SANDBOX_URL=http://127.0.0.1:4171
# Set to false to let the bot run commands without asking first
OPENBOT_REQUIRE_APPROVAL=true

# Web search (optional; the Exa endpoint works without a key)
# EXA_API_KEY=
# PARALLEL_API_KEY=
# OPENBOT_WEBSEARCH_PROVIDER=exa   # or parallel
