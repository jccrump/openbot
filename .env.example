# Copy to .env and fill in what you need. The daemon loads this automatically.

# Model API keys
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Daemon
OPENBOT_PORT=4170
# OPENBOT_DATA_DIR=~/.local/share/openbot   # defaults: macOS Application Support, Linux XDG, Windows AppData

# Sandbox (bot computers, served by the Lima VM)
OPENBOT_SANDBOX_URL=http://127.0.0.1:4171
# Set to false to let the bot run commands without asking first
OPENBOT_REQUIRE_APPROVAL=true
